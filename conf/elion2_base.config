/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Elion2 HPC base configuration — SLURM + Singularity settings shared by
    elion2_singularity and any elion_test profile.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params.igenomes_ignore = true

process {
    executor       = 'slurm'
    cpus           = 4
    memory         = '16 GB'
    time           = '8h'
    clusterOptions = {task.time < 72.h ? '-q batch' : '-q long'}
    clusterOptions = '-p gt_compute --exclude=elion015,elion016,elion017,elion019,elion023,elion024'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = '/gt/research_development/singularity/cache'
    runOptions = '-B /gt:/gt'
}

executor {
    name            = 'slurm'
    queueSize       = 50
    submitRateLimit = '1 / 2 s'
}
