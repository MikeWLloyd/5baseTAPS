/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    JAX Elion cluster — locally cached genome indices
    Overrides S3-based igenomes entries for genomes that have been pre-built locally.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // Flat params for control genome methylation QC subworkflow
    lambda_fasta   = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.fa"
    lambda_fai     = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.fa.fai"
    lambda_dict    = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.dict"
    lambda_bwamem2 = "/gt/research_development/igenomes/Controls/Lambda/Sequence/BWAmem2Index"
    puc19_fasta    = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.fa"
    puc19_fai      = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.fa.fai"
    puc19_dict     = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.dict"
    puc19_bwamem2  = "/gt/research_development/igenomes/Controls/pUC19/Sequence/BWAmem2Index"

    genomes {
        GRCh38 {
            fasta     = "/gt/research_development/igenomes/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa"
            fasta_fai = "/gt/research_development/igenomes/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa.fai"
            dict      = "/gt/research_development/igenomes/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.dict"
            bwamem2   = "/gt/research_development/igenomes/Homo_sapiens/NCBI/GRCh38/Sequence/BWAmem2Index/"
        }
        CHM13 {
            fasta     = "/gt/research_development/igenomes/Homo_sapiens/UCSC/CHM13/Sequence/WholeGenomeFasta/genome.fa"
            fasta_fai = "/gt/research_development/igenomes/Homo_sapiens/UCSC/CHM13/Sequence/WholeGenomeFasta/genome.fa.fai"
            dict      = "/gt/research_development/igenomes/Homo_sapiens/UCSC/CHM13/Sequence/WholeGenomeFasta/genome.dict"
            bwamem2   = "/gt/research_development/igenomes/Homo_sapiens/UCSC/CHM13/Sequence/BWAmem2Index/"
        }
        lambda_negCtrl {
            fasta     = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.fa"
            fasta_fai = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.fa.fai"
            dict      = "/gt/research_development/igenomes/Controls/Lambda/Sequence/WholeGenomeFasta/genome.dict"
            bwamem2   = "/gt/research_development/igenomes/Controls/Lambda/Sequence/BWAmem2Index"
        }
        puc19_posCtrl {
            fasta     = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.fa"
            fasta_fai = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.fa.fai"
            dict      = "/gt/research_development/igenomes/Controls/pUC19/Sequence/WholeGenomeFasta/genome.dict"
            bwamem2   = "/gt/research_development/igenomes/Controls/pUC19/Sequence/BWAmem2Index"
        }
    }
}
