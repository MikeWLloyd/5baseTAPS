/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    withName: 'BWA_INDEX|BWAMEM2_INDEX' {
        ext.when  = { !params.bwamem2 }
        memory    = { 96.GB * task.attempt }  // CHM13/GRCh38 FMI+BWT build peaks ~80-90 GB; 64 GB OOM'd at BWT step
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SAMTOOLS_FAIDX {
        ext.when = { !params.fasta_fai }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: SAMTOOLS_DICT {
        ext.when = { !params.dict }
        publishDir = [
            path: { params.save_reference ? "${params.outdir}/genome" : params.outdir },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename != 'versions.yml' && params.save_reference ? filename : null },
        ]
    }

    withName: FASTQC {
        cpus = { 4 * task.attempt }
        memory = { 4.GB * task.attempt }
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/fastqc" },
            mode: params.publish_dir_mode,
            pattern: "*.{html,zip}",
        ]
    }

    withName: 'CONCAT_FASTQ_R1|CONCAT_FASTQ_R2' {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 24.h * task.attempt }
        publishDir = [ enabled: false ]
    }
    withName: CONCAT_FASTQ_R1 {
        ext.prefix = { "${meta.id}_R1" }
    }
    withName: CONCAT_FASTQ_R2 {
        ext.prefix = { "${meta.id}_R2" }
    }

    withName: FASTQTOBAM {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        publishDir = [ enabled: false ]  // intermediate only; consumed by ctrl workflows via channel
    }

    // Split-align-merge — SPLIT_FASTQ, FASTQTOBAM_CHUNK, ALIGN_RAW_CHUNK, MERGE_CHUNKS
    withName: SPLIT_FASTQ {
        // seqkit split2 --by-part N opens (N_chunks×2 + 2) bgzf streams simultaneously
        // (2 input decompressors + N_chunks×2 output compressors).
        // --threads = N_chunks×2 + 2 (one per bgzf stream); +2 CPUs for seqkit coordinator
        // thread + shell/singularity overhead.
        // Memory: seqkit streams in ~563 MB RSS regardless of file size; 4 GB is generous.
        // Time: 12 h covers large whole-genome samples.
        cpus   = { ((params.align_raw_bam_chunks ?: 4) * 2 + 4) * task.attempt }
        memory = { 4.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: FASTQTOBAM_CHUNK {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        ext.prefix = { "${meta.id}.lane${meta.lane}.chunk_${meta.chunk}" }
        publishDir = [ enabled: false ]
    }

    withName: ALIGN_RAW_CHUNK {
        // 16 CPUs: bwa-mem2 at 12 threads (75% efficiency sweet spot for ~60M read chunks)
        // No samtools sort (sort_type="none" — single global sort in MERGE_CHUNKS instead)
        // Thread budget: fastq=2, bwa=12, fgbio=2 → total 16
        cpus                 = { 16 * task.attempt }
        memory               = { 48.GB * task.attempt }
        time                 = { 8.h * task.attempt }
        ext.samtools_threads = 2   // -@ 2 for samtools fastq
        ext.bwa_cpu_reserve  = 4   // bwa gets 16-4=12; fgbio gets 4-2=2
        ext.prefix           = { "${meta.id}.lane${meta.lane}.chunk_${meta.chunk}" }
        publishDir           = [ enabled: false ]
    }

    withName: MERGE_CHUNKS {
        cpus   = { 16 * task.attempt }
        memory = { 192.GB * task.attempt }  // 16 threads × 8 GB sort buffer
        time   = { 2.h * task.attempt }
        ext.sort_mem = '8G'
        ext.prefix   = { "${meta.id}.lane${meta.lane}" }
        publishDir = [ enabled: false ]  // per-lane intermediate; MERGE_BAM publishes the final per-sample BAM
    }

    withName: 'ALIGN_RAW_BAM|ALIGN_CONS' {
        cpus                       = { 44 * task.attempt }
        memory                     = { 96.GB * task.attempt }
        ext.samtools_threads       = 4    // -@ 4 for samtools fastq
        ext.samtools_sort_threads  = 6    // -@ 6 for samtools sort
        ext.bwa_cpu_reserve        = 14   // bwa gets cpus-14=30; fgbio gets 14-4-6=4
        ext.samtools_sort_mem      = '8G' // 6 threads × 8 GB = 48 GB sort buffer
    }

    withName: ALIGN_RAW_BAM {
        publishDir = [ enabled: false ]
    }

    withName: MERGE_BAM {
        // MB032_DIA was wall-time killed at 3:59:28 against a 4 h limit (exit 140 = SIGTERM, not OOM).
        // Primary fix is time. CPUs raised to 8 for 7 parallel I/O threads (--threads task.cpus-1).
        // Memory 16 GB matches the successful retry; no evidence higher memory is needed.
        cpus   = { 8 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 12.h * task.attempt }
        ext.args = '--template-coordinate'
        publishDir = [ enabled: false ]
    }

    withName: GROUP_UMI {
        // Sumner showed MaxRSS = ReqMem = 48 GB exactly, but this is a cgroup kill artifact —
        // Elion completed the same samples at only 12-22 GB peak. Root cause on Sumner unclear.
        // Keeping at 48 GB; exit 247 retry will auto-escalate to 96 GB if a genuine OOM occurs.
        cpus   = { 4 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h * task.attempt }
        publishDir = [
            [
                enabled: false,                // grouped.bam is intermediate; cons.filtered.bam is the final BAM
                path: { "${params.outdir}/${meta.id}/qc/duplex" },
                mode: params.publish_dir_mode,
                pattern: '*.grouped.bam',
            ],
            [
                path: { "${params.outdir}/${meta.id}/qc/duplex" },
                mode: params.publish_dir_mode,
                pattern: '*.grouped-family-sizes.txt',
            ],
        ]
    }

    withName: DUPLEX_QC {
        // fgbio CollectDuplexSeqMetrics is single-threaded; Sumner peaked at ~80 GB on
        // ~950 M-record / 3.4 TB grouped BAMs. 96 GB = 80 GB × 1.2 headroom. The module
        // reserves 8 GB for JVM off-heap (GC metadata, metaspace, native I/O buffers),
        // so -Xmx = 88 GB. CPUs > 2 give no benefit — bottleneck is memory, not compute.
        cpus   = 2
        memory = { 96.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/duplex" },
            mode: params.publish_dir_mode,
            pattern: '*duplex_seq_metrics*.{txt,pdf}',
        ]
    }

    withName: 'CALL_DUPLEX|CALLMOLECULARCONSENSUSREADS' {
        // All 3 samples hit exactly 32 GB (MaxRSS = ReqMem) in 4:17-4:21 h — at the ceiling.
        // fgbio passes --threads ${task.cpus} so CPU increase directly parallelises family processing.
        cpus   = { 16 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 12.h * task.attempt }
        publishDir = [ enabled: false ]   // unmapped consensus is intermediate; cons.filtered.bam is the final BAM
    }

    withName: 'CALLANDFILTERDUPLEXCONSENSUSREADS|CALLANDFILTERMOLECULARCONSENSUSREADS|CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/bam" },
            mode: params.publish_dir_mode,
            pattern: '*.cons.filtered.{bam,bam.bai}',
        ]
    }

    withName: CONSENSUS {
        cpus               = { 8 * task.attempt }
        memory             = { 72.GB * task.attempt }
        time               = { 12.h * task.attempt }
        ext.fgbio_mem_gb   = 32   // -Xmx32g
        ext.samtools_threads = 5  // 5 sort threads; fgbio(1-2) + sort(5) + GC(1) ≈ 8 cores
        ext.samtools_args  = '-m 5G'  // 5 threads × 5 GB = 25 GB sort buffer
    }

    withName: ALIGN_CONS {
        // Consensus BAM is much smaller than raw BAM; bwa-mem2 saturates at ~16 threads.
        // 27 CPUs: bwa=16, samtools_fastq=4, samtools_sort=6, fgbio=1
        cpus                  = { 27 * task.attempt }
        memory                = { 80.GB * task.attempt }
        ext.bwa_cpu_reserve   = 11   // bwa gets 27-11=16; fgbio gets 11-4-6=1
        ext.samtools_sort_mem = '4G' // 6 threads × 4 GB = 24 GB sort buffer
        publishDir = [ enabled: false ]   // aligned-but-unfiltered BAM is intermediate; cons.filtered.bam is the final BAM
    }

    withName: PERREAD {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_perread.bed.gz",
        ]
    }

    withName: TABIX_TABIX {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.tbi",
        ]
    }

    withName: RASTAIR_CALL {
        cpus   = { 25 * task.attempt }
        memory = { 48.GB * task.attempt }
        time   = { 16.h * task.attempt }
        ext.threads = 24
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/methylation" },
                mode: params.publish_dir_mode,
                pattern: "*.rastair_call.bed.gz",
            ],
            [
                path: { "${params.outdir}/${meta.id}/methylation" },
                mode: params.publish_dir_mode,
                pattern: "*.rastair_call.vcf.gz",
            ],
        ]
    }

    // RASTAIR_CALL_CPGS_ALL  (--cpgs-only --all)           and
    // RASTAIR_CALL_CPGS_EMPTY (--cpgs-only --bed-include-empty)
    // were removed because rastair 2.1.1 has two bugs that make both flags ineffective
    // on BED output: (1) the --all match arm still requires coverage, and (2) zero-coverage
    // reference CpGs never enter the pileup pipeline so --bed-include-empty has no effect.
    // Re-add these blocks and restore the includes/calls in
    // subworkflows/nf-core/bam_taps_conversion/main.nf once a fixed rastair image is available.

    // Per-chromosome M-bias — two-stage replacement for RASTAIR_MBIAS.
    // Stage 1a: list primary chromosomes from tabix index (fast, 1 GB)
    withName: GET_CHRS {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 1.h  * task.attempt }
        publishDir = [ enabled: false ]  // intermediate — bgz/tbi are staged inputs; chromosomes.txt has no sample prefix
    }

    // Stage 1b: per-chromosome RDS computation (parallel; peak ~34 GB on chr3)
    withName: MBIAS_CHR {
        cpus   = 2
        memory = { 80.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        publishDir = [ enabled: false ]  // intermediate — RDS files staged into RENDER from work/
    }

    // Stage 2: gather all RDS files and render the HTML report
    withName: RENDER {
        cpus   = 2
        memory = { 64.GB * task.attempt }
        time   = { 3.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_mbias.html",
        ]
    }

    withName: METH_SUMMARY {
        // Default: global ALL row + per-chromosome rows.
        // To suppress per-chromosome rows (global ALL only): ext.args = '--all-cpgs'
        // --all-cpgs: BED from RASTAIR_CALL_ALLCPG (--cpgs-only --all) enables breadth columns.
        ext.args = '--per-chr --all-cpgs'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: METHYLKIT {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.txt.gz",
        ]
    }

    withName: CPG_MASK {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.rastair_cpg_sites.bed.gz{,.tbi}",
        ]
    }

    // ── Control genome methylation QC (lambda + pUC19 spike-ins) ─────────────
    // Control genomes are tiny; intermediate files are not published.

    withName: 'LAMBDA_ALIGN_RAW_BAM|LAMBDA_ALIGN_CONS|PUC19_ALIGN_RAW_BAM|PUC19_ALIGN_CONS' {
        cpus                 = { 12 * task.attempt }
        memory               = { 4.GB * task.cpus }
        ext.samtools_threads = 2   // -@ 2 for each samtools fastq/sort
        ext.bwa_cpu_reserve  = 6   // bwa gets cpus-6=6; fgbio gets 6-(2*2)=2
        ext.filter_unmapped  = true // drop unmapped reads; controls only need mapped reads
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_ALIGN_RAW_BAM|LAMBDA_ALIGN_CONS' {
        ext.prefix = { meta.containsKey('lane') ? "${meta.id}.lane${meta.lane}.lambda_negCtrl" : "${meta.id}.lambda_negCtrl" }
    }

    withName: 'PUC19_ALIGN_RAW_BAM|PUC19_ALIGN_CONS' {
        ext.prefix = { meta.containsKey('lane') ? "${meta.id}.lane${meta.lane}.puc19_posCtrl" : "${meta.id}.puc19_posCtrl" }
    }

    withName: 'LAMBDA_ALIGN_CONS|PUC19_ALIGN_CONS' {
        // Control genomes are tiny (lambda 48.5 kb, pUC19 2.7 kb); peak RSS 5.2 GB / 2.9 GB observed.
        // filter_unmapped=true means sort only sees mapped control reads — single sort thread sufficient.
        // bwa_cpu_reserve=4: bwa=2, fgbio=max(1,4-2-1)=1, samtools_fastq=2, samtools_sort=1 → total=6
        cpus                     = { 6 * task.attempt }
        memory                   = { 16.GB * task.attempt }
        ext.bwa_cpu_reserve      = 4
        ext.samtools_sort_threads = 1
    }

    withName: 'LAMBDA_MERGE_BAM|PUC19_MERGE_BAM' {
        ext.args   = '--template-coordinate'
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_GROUP_UMI|PUC19_GROUP_UMI' {
        cpus   = { 4 * task.attempt }
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_CALL_DUPLEX|LAMBDA_CALLMOLECULARCONSENSUSREADS|PUC19_CALL_DUPLEX|PUC19_CALLMOLECULARCONSENSUSREADS' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_CONSENSUS|PUC19_CONSENSUS' {
        cpus   = { 4 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_RASTAIR_CALL|PUC19_RASTAIR_CALL' {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: 'LAMBDA_METH_SUMMARY' {
        ext.args   = '--per-chr'
        ext.prefix = { "${meta.id}.lambda_negCtrl" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: 'PUC19_METH_SUMMARY' {
        ext.args   = '--per-chr'
        ext.prefix = { "${meta.id}.puc19_posCtrl" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/methylation" },
            mode: params.publish_dir_mode,
            pattern: "*.methylation_summary.tsv",
        ]
    }

    withName: GATK4_COMPOSESTRTABLEFILE {
        cpus   = 4
        memory = { 16.GB * task.attempt }
        time   = { 4.h * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: GATK4_CALIBRATEDRAGSTRMODEL {
        cpus   = { 8 * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/variant_call" },
            mode: params.publish_dir_mode,
            pattern: "*.dragstr_model.txt",
        ]
    }

    withName: EXTRACT_MAJOR_CHROMS {
        cpus   = 1
        memory = { 1.GB * task.attempt }
        time   = { 10.min * task.attempt }
        publishDir = [ enabled: false ]
    }

    withName: GATK4_HAPLOTYPECALLER {
        // Scattered per chromosome (chr1..22, X, Y → ~24 parallel tasks per sample).
        // HC is single-threaded; only the PairHMM kernel parallelizes (capped at 4
        // threads inside the module). >8 CPUs shows diminishing returns due to
        // thread contention.
        cpus   = { 6 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 24.h * task.attempt }
        // Intermediate per-chrom VCFs are merged via GATK4_MERGEVCFS before publish;
        // keeping per-chrom files unpublished avoids cluttering the output dir.
        publishDir = [ enabled: false ]
    }

    withName: GATK4_MERGEVCFS {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        // Annotate merged VCF header so the surviving GATKCommandLine entry
        // (which arbitrarily reflects only one of the 24 per-chrom HC runs)
        // is not mistaken as representing the full merged VCF coverage.
        ext.args = '--COMMENT "Merged from scattered per-chromosome HaplotypeCaller runs (chr1-22,X,Y); surviving GATKCommandLine entry is representative of parameters used for all 24 per-chrom runs"'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz{,.tbi}",
        ]
    }

    withName: GATK4_VARIANTFILTRATION {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 4.h * task.attempt }
        ext.prefix = { "${meta.id}.haplotypecaller" }
        // DRAGENHardQUAL is hardcoded in the module (Broad WARP DRAGEN best practice).
        // Supplementary filters below follow standard GATK hard-filter guidance but are
        // NOT specifically validated for DRAGEN-mode output — evaluate empirically on
        // first multi-sample run before enabling.
        // ext.args = [
        //     '--filter-expression "FS > 60.0 || SOR > 3.0" --filter-name "StrandBias"',
        //     '--filter-expression "ReadPosRankSum < -8.0"  --filter-name "ReadPos"',
        //     '--filter-expression "MQ < 40.0"              --filter-name "LowMQ"',
        //     '--filter-expression "MQRankSum < -12.5"      --filter-name "MQRankSum"',
        // ].join(' ')
        publishDir = [ enabled: false ]  // intermediate — split into SNP/INDEL by BCFTOOLS_SPLITVCF
    }

    withName: BCFTOOLS_SPLITVCF {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.haplotypecaller" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/variants" },
            mode: params.publish_dir_mode,
            pattern: "*.vcf.gz{,.tbi}",
        ]
    }

    // ── Phase 1 QC metrics ───────────────────────────────────────────────────

    withName: METHYL_QC {
        cpus       = 1
        memory     = { 2.GB * task.attempt }
        time       = { 30.m * task.attempt }
        ext.genome = { params.genome ?: "Sample" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: 'SAMTOOLS_FLAGSTAT|LAMBDA_SAMTOOLS_FLAGSTAT|PUC19_SAMTOOLS_FLAGSTAT' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        // Raw per-lane BAM flagstat — not published; metrics are captured via prededup flagstat.
        ext.prefix = { "${meta.id}.rawlane" }
        publishDir = [ enabled: false ]
    }

    withName: LAMBDA_SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.lambda_negCtrl" }
    }

    withName: PUC19_SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.puc19_posCtrl" }
    }

    withName: BCFTOOLS_STATS {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/variant_call" },
            mode: params.publish_dir_mode,
            pattern: "*.bcftools_stats.txt",
        ]
    }

    // ── Phase 1 QC: post-dedup flagstat, mosdepth, per-sample metric CSVs ───────

    withName: PREDEDUP_FLAGSTAT {
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.prededup" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: POSTDEDUP_FLAGSTAT {
        cpus      = 2
        memory    = { 4.GB * task.attempt }
        time      = { 1.h * task.attempt }
        ext.prefix = { "${meta.id}.postdedup" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/alignment" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat",
        ]
    }

    withName: MOSDEPTH {
        cpus   = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
        time   = { 2.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/coverage" },
            mode: params.publish_dir_mode,
            pattern: "*.mosdepth.{summary,global.dist}.txt",
        ]
    }

    withName: ALIGN_QC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: DUPLEX_MQC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: WGS_QC {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: TAPS_VC_METRICS {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/mqc" },
            mode: params.publish_dir_mode,
            pattern: "*_mqc.tsv",
        ]
    }

    withName: TAPS_QC_REPORT {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/qc" },
            mode: params.publish_dir_mode,
            pattern: "taps_qc_report.{html,tsv}",
        ]
    }

    withName: 'TAPS_MULTIQC' {
        cpus   = { 4 * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
